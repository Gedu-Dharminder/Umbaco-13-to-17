    }
    .link-tab .component-main.show{
        display: block;
        margin-top: 0px !important;
    }
    .link-tab .heading{
        padding: 5px 0px 5px 0px;
    }
    .link-tab .heading.show{
        color: #cea666 !important;
    }
    .link-tab .heading::before{
        content: "\002B";
        font-size: 25px;
        font-weight: 600;
        padding: 0;
        position: absolute;
        right: 0;
        top: 0;
        margin: 0;
        color: #cea666 !important;
    }
