/**********************************Heading global Style *************************************/
.heading:after{
 display: none !important;    
}

/***********************************site Footer global Style**********************************/

#site-footer .listing{
    justify-content: space-between;
}
.footer-highlight{
    display: none !important;
}
.footer-social-media ul {
    list-style: none;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin: 0;
}
.footer-social-media ul li{
    margin-right:15px;
}
.footer-social-media ul li a{
    font-size: 14px !important;
}
.footer-social-media ul li span{
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px;
    background: #FFFFFF26;
    border-radius: 50px;
    border: 2px solid #FFFFFF33;
}
.footer-address ul {
    list-style: none;
    margin-left: 0px;
}
.footer-address ul li{
    display: flex;
    justify-content: start;
    align-items: start;
}
.footer-address ul li span{
    margin: 0px 10px 10px 0px;
}
nav.footer-navigation{
    border-top: 1px solid #FFFFFF4D;
    padding-top: 20px;
    padding-bottom: 30px;
}
.footer-navigation ul{
    display: flex;
    justify-content: space-between;
    align-items: center;
}
#site-footer .item.footer-item .footer-heading{
    font-size: 16px !important;
}

  #site-footer .item.footer-item .component-main .item a{
        font-size: 12px !important;
        line-height: 16px;
        /*white-space: nowrap;*/
        color: #FFFFFFCC;
        font-weight: 400;
        padding-right: 20px;
    }
    #site-footer .listing{
        position: relative;
    }
    .border-footer{
        position: static;
    }
    .border-footer::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 1px;
    background: #ffffff4d;
    left: 0px;
    top: 160px;
    margin: auto;
}
@media (min-width: 1500px){
    .border-footer::before{
            top: 192px;
    }
}

@media (max-width: 1199px){
    .border-footer::before {
    top: 177px;
}
}
@media (max-width: 1198px){
    .border-footer::before {
    top: 190px;
}
}
@media (max-width: 1052px){
    .border-footer::before {
    top: 220px;
}
}
@media (max-width: 1010px){
    .border-footer::before {
