    <customCSS>
      <Value><![CDATA[/*********************************Site header global css*****************************************/
#site-header .cta-links{
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}
#site-header .cta-links .btn , #site-header .cta-links .btn:hover span , #site-header .cta-links .btn:focus span{
    background: none;
    color: #fff;
    border: none;
    padding: 0;
}
.custom-home{
    z-index: 999;
    top: 30%;
    right: 100px;
}

a[rel="email "]:after{
    content:"";
    position: absolute;
    width:15px;
    height:15px;
    left: -18px;
    top: 5px;
    background-image: url(/media/pl0ijqbm/email.svg);
    background-size:cover;
    background-repeat: no-repeat;
    background-position: center;
}
a[rel="phone "]{
    margin: 0px !important;
}
a[rel="phone "]:after{
    content:"";
    position: absolute;
    width:15px;
    height:15px;
    left: -18px;
    top: 3px;
    background-image: url(/media/1iraoc2k/phone-3.svg);
    background-size:cover;
    background-repeat: no-repeat;
    background-position: center;
}
header#site-header nav.main ul > li.has-child > ul > li.has-child > ul > li.active > span > a{
        color: #fff !important;
    }
@media (min-width: 992px){
    header#site-header{
        overflow: visible !important;
    }
    html.reveal-out{
        overflow: visible !important; 
    }
    .reveal-out header#site-header {
        height: 180px !important;
        overflow: visible !important;
    }
    .expand-subpages{
        display: none !important;
    }
    
    button#burgerNavStyle{
        height: 40px !important;
        width: 140px !important;
        top: 70px !important;
        background: #00AEC7 !important;
    }
    button#burgerNavStyle::after {
        content: "Menu";
        position: absolute;
        text-indent: 1px;
        right: 65px;
        top: 7px;
        color: #00142E;
        text-transform: uppercase;
    }
    header#site-header .expand-header span {
        background: #00142E !important;
        transform: translate(100%, -50%) !important;
        height: 2px;
        width: 20px;
    }
    
    header#site-header .expand-header span:before ,  header#site-header .expand-header span:after{
        background: #00142E !important;
        height: 2px;
        border-radius: 50px;
        width: 20px;
    }
    .reveal-out button#burgerNavStyle::after {
        content: "Close";
    }
    .reveal-out header#site-header .expand-header span {
        background: none !important;
    }
    
    
    .form.site-search-form.site-search.open-search {
        background: #00142e !important;
        top: var(--large-header) !important;
        right: 0 !important;
        max-width: 50% !important;
        padding-right: 151px !important;
    }
    
    .form.site-search-form.site-search.open-search button.expand-search {
        right: 85px !important;
        background: #00aec7 !important;
        height: 50px !important;
        width: 50px !important;
        top: 3px !important;
        color: #00142e !important;
    }
    
    nav.main.nav-dropdown{
        width: 0% !important;
        transition: width .5s linear;
        display: block !important;
        right: 0;
        top: var(--large-header);
        padding-top: 25px;
        position: fixed !important;
        height: 100vh !important;
        background: linear-gradient(270.2deg, #00142E 24.61%, rgba(0, 20, 46, 0.8) 59.59%);
        overflow: hidden;
    }
    nav.main.nav-dropdown.navigation-dropdown-bg.navigation-dropdown-bg-solid >ul:before {
        content: "";
        position: absolute;
        display: block;
        width: 0px;
        height: 374px;
        right: 100px;
        top: 20px;
        background-image: url("/media/p00n4zha/menu-logo.svg");
        background-repeat: no-repeat;
        background-position:right;
        background-size:contain;
    }
    .reveal-out nav.main.nav-dropdown.navigation-dropdown-bg.navigation-dropdown-bg-solid >ul:before {
        width: 450px;
    }
    .reveal-out nav.main.nav-dropdown{
        width: 100% !important;
         top: var(--large-header);
    }

    header#site-header nav.main > ul{
        max-width: 1440px !important;
        margin: auto !important;
        display: flex !important;
        align-items: center;
        position: relative;
        padding-left: 113px;
        padding-right: 90px;
    }
    nav.main > ul > li{
        text-align: left;
        padding: 0px 10px !important;
        animation: none !important;
        transition: none;
    }
    nav.main > ul > li:first-child{
        padding: 0px !important;
    }
     nav.main > ul > li:first-child a{
         position: relative;
         width: 0px !important;
         font-size: 0px;
     }
    nav.main > ul > li:first-child a:before {
        content: " ";
        position: absolute;
        top: 20px;
        background-image: url(/media/5zonjsou/arrow-1.svg);
        display: block;
        width: 23px;
        height: 15px;
        left: -22px;
        background-position: center;
        background-size: cover;
    }

    nav.main  ul  li{
        position: static !important;
    }
    nav.main > ul > li  span:after{
        display: none !important;
    }
    
    nav.main > ul > li > span > a{
        padding: 15px 0px !important;
        height: auto !important;
        min-height: 25px !important;
    }
    nav.main > ul > li.active > span > a{
        border-bottom: 3px solid;
    }
    nav.main > ul > li.bottom-border > span > a{
        border-bottom: 3px solid #cea666;
        color: #cea666;
    }
    body header#site-header nav.main > ul > li.has-child > ul {
        position: absolute !important;
        width: 340px;
        padding-top: 30px;
        left: 90px !important;
        /*background: #00142e;*/
    }
    body header#site-header nav.main > ul > li.has-child > ul>li.has-child:after{
        content: "";
        position:absolute;
        top: 30px;
        width: 1px;
        background: #ffffff14;
        height: 90%;
        left: 300px;
    }
    body header#site-header nav.main > ul > li.has-child ul:before{
        display: none !important;
    }
    body header#site-header nav.main ul li.has-child > ul li span a{
        padding: 10px 0px !important;
        white-space: nowrap;
        font-family: "essonnes-display-regular', essonnes-display-regular" !important ;
        font-size: 26px;
    }
    header#site-header nav.main ul > li.has-child > ul > li.has-child > ul{
        display: none;
        position: absolute !important;
        top: 20px;
        left: 250px !important;
        padding-left: 85px !important;
    }
    nav.main.nav-dropdown > ul > li.has-child > ul > li.has-child.arrow:hover > span > a:after{
        content: "\27F6";
        position: absolute;
        color:#CEA666;
        margin-left: 10px;
        
    }
     nav.main.nav-dropdown > ul > li.has-child > ul > li.no-child.arrow:hover > span > a:after{
         display: none;
     }
    nav.main.nav-dropdown > ul > li.has-child > ul > li.has-child.arrow > ul {
        display: block !important;
    }
    header#site-header nav.main ul > li.has-child > ul > li.has-child > ul > li > span > a{
        font-size: 16px !important;
        font-family: "Soleil-Regular" !important;
        position: relative;
        text-decoration: none;
        width: fit-content;
    }
    
    header#site-header nav.main ul > li.has-child > ul > li.has-child > ul > li > span > a::after{
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;           
        height: 2px;            
        width: 100%;
        background: #CEA666;
        transform: scaleX(0);
        transform-origin: left center; 
        transition: transform 0.3s ease;
    }
    
    header#site-header nav.main ul > li.has-child > ul > li.has-child > ul > li > span > a:hover::after{
        transform: scaleX(1);
    }
    
    .form.site-search-form.site-search form{
        display: none !important; 
       
    }
    .form.site-search-form.site-search.open-search form{
        display: block !important;
        top: -42px !important;
    }
    .form.site-search-form.site-search .expand-search{
        display: block !important; 
        transition: none !important;
    }

    .form.site-search-form.site-search {
        top: 67px !important;
        position: absolute !important;
        right: 180px !important;
        display: block !important;
        transition: none !important;
        animation: none !important;
    }
    body.header-03-lg header#site-header nav.cta-links{
        top : unset !important;
    }
    body.header-03-lg header#site-header .row{
        padding: 0px !important;
    }
    
}

.form.site-search-form.site-search .form-control{
    background: none;
    border: 1px solid #cea666 !important;
    color: #cea666;
}
.form.site-search-form.site-search .form-control::placeholder {
