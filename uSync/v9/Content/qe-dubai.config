    <additionalButtonColorCSS>
      <Value><![CDATA[/**********************************global custom button**********************************/

.custom-btn {
    background: #ffffff00;
    color: #cea666;
    border: 1px solid #cea666;
    border-radius: 100vw;
    padding: 3px 10px !important;
}
.custom-btn:hover {
    background: #ffffff00;
    color: #cea666 !important;
    border: 1px solid #cea666;
    border-radius: 100vw;
}
body.content-underline-link #site-content .item .text .custom-btn2 a:not(.btn):not(.nav-button-link):not(:hover):not(:focus):not(:active) {
    letter-spacing: 2.37px;
    text-transform: uppercase;
    text-decoration: none !important;
    font-size: 10px;
    font-weight: 400;
}

.bluebtn:hover{
    color: #00142e !important;
    letter-spacing: 2.37px !important;
        text-transform: uppercase !important;
    text-decoration: none !important;
    font-family:'Soleil-Regular', Soleil-Regular !important;
        font-size: 10px !important;
    font-weight: 400 !important;
}
body.content-underline-link #site-content .item .text .custom-btn2 a:hover{
    letter-spacing: 2.37px !important;
        text-transform: uppercase !important;
    text-decoration: none !important;
    font-family:'Soleil-Regular', Soleil-Regular !important;
        font-size: 10px !important;
    font-weight: 400 !important;
}
body.content-underline-link #site-content .item .text .custom-btn2 a:focus{
    letter-spacing: 2.37px !important;
        text-transform: uppercase !important;
    text-decoration: none !important;
    font-family:'Soleil-Regular', Soleil-Regular !important;
        font-size: 10px !important;
    font-weight: 400 !important;
}
.custom-btn3{
    padding: 8px 12px;
    color: #00142E !important;
    background: #CEA666;
    border: 1px solid #CEA666;
    text-decoration: none !important;
}
.custom-btn3:hover{
    color: #CEA666 !important;
    background: none;
}
.slick-prev{
    background: none !important;
    border: 1px solid #85754E !important;
    left: -45px !important;
    color:#85754E !important;
}
.slick-next{
    background: none !important;
    border: 1px solid #85754E !important;
    right: -45px !important;
    color:#85754E !important;
}
.slick-autoplay-toggle-button{
    display: none !important;
}

.row.slides:not(.listing_no-spacing) .item {
    padding: 0 5px;
}


.slick-slider ul.slick-dots{
    display: none !important;
}
.slick-slider .slick-dots li{
    margin: 0px !important;
}
.slick-slider .slick-dots li > button{
    background: #00AEC71A !important;
    width: 10px !important;
    height: 10px !important;
}
.slick-slider .slick-dots li.slick-active > button {
    background: #00AEC7 !important;
    width: 12px !important;
    height: 12px !important;
}
.slick-slider .slick-dots li:not(.slick-active) > button:hover {
    opacity: 1;
    background: #00AEC7;
}
@media (max-width: 768px){
    .slick-arrow{
        display: none !important;
    }
    .slick-slider ul.slick-dots{
    display: flex !important;
    margin-top: 0 !important;
}
}
@media (max-width: 512px){
.component .slick-slider .slick-list,.component .slick-slider .slick-track {
    padding-right: 80px;
}
.custom-btn{
    margin: 0px !important;
}
}

/*back to top button style for mobile*/

@media(max-width: 768px){
   
    #back-to-top-link{
        width: 35px;
        height: 35px;
    }
    .usn_back-to-top{
    position: fixed !important;
    bottom: 45px !important;
    right: 10px !important;
    padding-top: 0 !important;
    z-index: 999;
    }
     html.reached-top .usn_back-to-top{
        bottom: 0px !important;
    }
    .usn_back-to-top.footer-visible{
    position: absolute !important;
    bottom: unset !important;
    top: 5px !important;
    right: 10px !important;
    padding-top: 0 !important;
    }
}
@media (min-width: 768px) {
    nav.footer-navigation ul li:first-child {
        margin-right: auto;
    }
    nav.footer-navigation ul li:nth-child(2) {
        border-right: 1px solid #fff;
