    },
    {
      "contentTypeKey": "d0d38c45-5d97-4f17-b962-9e67c69146fd",
      "displayIntro": "1",
      "displayOutro": "0",
      "enableRandomOrder": "0",
      "introButtons": "",
      "introHeading": {
        "text": "",
        "headingtag": ""
      },
      "introSecondaryHeading": {
        "text": "Mission, vision and values",
        "headingtag": "s"
      },
      "introText": {
        "markup": "<p>Queen Elizabeth's School, Dubai Sports City is inspired by the legacy of Queen Elizabeth’s School, Barnet, one of the United Kingdom’s most successful grammar schools. Founded by royal charter in 1573, QE Barnet has, for over four and a half centuries, stood as a symbol of academic distinction, leadership, and moral integrity.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "introTextAlignment": "justify-content-center text-center",
      "outroButtons": "",
      "outroHeading": {
        "text": "",
        "headingtag": ""
      },
      "outroSecondaryHeading": {
        "text": "",
        "headingtag": ""
      },
      "outroText": "",
      "outroTextAlignment": "",
      "pods": {
        "layout": {
          "Umbraco.BlockList": [
            {
              "contentUdi": "umb://element/7c41bc26575542f68bd3e2f93cef4add",
              "settingsUdi": "umb://element/d88801f65e0043a08b15eb4b94b99228"
            },
            {
              "contentUdi": "umb://element/c998585de4e94eee80744978d3d3b4ab",
              "settingsUdi": "umb://element/ea63cc84dbd143cf824c166c8866e0bc"
            },
            {
              "contentUdi": "umb://element/cca1aa4d507141fb82fce0b96d049c3b",
              "settingsUdi": "umb://element/8a6b82fc7ee84d6684bbf7f794d1b36a"
            }
          ]
        },
        "contentData": [
          {
            "contentTypeKey": "7e9ea8e8-6378-441e-ae49-59f545ceb8bf",
            "hidePodButton": "0",
            "podButton": "",
            "podHeading": {
              "text": "Mission",
              "headingtag": "l"
            },
            "podImage": "",
            "podSecondaryHeading": {
              "text": "",
              "headingtag": ""
            },
            "podText": {
              "markup": "<p>Our mission is to nurture confident, able and responsible young people; prepared to lead happy and fulfilled adult lives and to make a positive contribution to others.</p>\n<p class=\"custom-btn2\"><a href=\"/about-us/#mission\">find out more</a></p>",
              "blocks": {
                "contentData": [],
                "settingsData": []
              }
            },
            "udi": "umb://element/7c41bc26575542f68bd3e2f93cef4add"
          },
          {
            "contentTypeKey": "7e9ea8e8-6378-441e-ae49-59f545ceb8bf",
            "hidePodButton": "0",
            "podButton": "",
            "podHeading": {
              "text": "Vision",
              "headingtag": "l"
            },
            "podImage": "",
            "podSecondaryHeading": {
              "text": "",
              "headingtag": ""
            },
            "podText": {
              "markup": "<p>Our vision at Queen Elizabeth's School, Dubai Sports City is to be a global leader in British international education, shaping the next generation of thoughtful, high-achieving and globally engaged citizens.</p>\n<p class=\"custom-btn2\"><a href=\"/about-us/#our-vision\" class=\"bluebtn\">find out more</a></p>",
              "blocks": {
                "contentData": [],
                "settingsData": []
              }
            },
            "udi": "umb://element/c998585de4e94eee80744978d3d3b4ab"
          },
          {
            "contentTypeKey": "7e9ea8e8-6378-441e-ae49-59f545ceb8bf",
            "hidePodButton": "0",
            "podButton": "",
            "podHeading": {
              "text": "Values",
              "headingtag": "l"
            },
            "podImage": "",
            "podSecondaryHeading": {
              "text": "",
              "headingtag": ""
            },
            "podText": {
              "markup": "<p>Our values at Queen Elizabeth's School, Dubai Sports City, are to uphold excellence, integrity and, inclusivity in all we do. Our 450-year legacy inspires us to nurture individuals who are curious, compassionate, and globally aware.</p>\n<p class=\"custom-btn2\"><a href=\"/about-us/#our-values\">find out more</a></p>",
              "blocks": {
                "contentData": [],
                "settingsData": []
              }
            },
            "udi": "umb://element/cca1aa4d507141fb82fce0b96d049c3b"
          }
        ],
