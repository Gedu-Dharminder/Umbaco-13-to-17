            "animationStyle": "slideInLeft",
            "contentTypeKey": "13eb5cb1-ad1d-4a18-8b66-f7accd43fdb9",
            "customSplitSectionClasses": "box left executive-welcome pt-md-5 pe-md-0 ps-md-5",
            "desktopColumnWidth": "7",
