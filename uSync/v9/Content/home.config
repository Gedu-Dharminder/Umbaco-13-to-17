    .explore-section.content .component-introduction {
    padding-bottom: 48px !important;
    width: 100%;
}
.hover-effect::after{
    content: "";
    position: absolute;
    width: 100%;
    height: 0px;
    background: #00AEC7;
    left: 0;
    bottom: 0;
    opacity:0;
    transition: all .5s ease;
}
.hover-effect:hover::after{
    height: 20px;
     opacity:1;
}
.hover-effect2 .inner::before{
    content: "";
    position: absolute;
    width: 100%;
    height: 0px;
    background: #00AEC7;
    left: 0;
    bottom: 0;
    opacity:0;
    transition: all .5s ease;
}
.hover-effect2:hover .inner::before{
    height: 10px;
     opacity:1;
     z-index: 9;
}
}
