      <Value Culture="en-us"><![CDATA[{
  "layout": {
    "Umbraco.BlockList": [
      {
        "contentUdi": "umb://element/febd7773c3534d95a476c1ff18910223",
        "settingsUdi": "umb://element/75972f199796467ea6f1e4dca695e352"
      }
    ]
  },
  "contentData": [
    {
      "code": "<div class=\"popup-overlay\" id=\"popup\">\r\n  <div class=\"popup-content\">\r\n    <button class=\"close-btn\" id=\"closePopup\">&times;</button>\r\n    <!-- Desktop image -->\r\n     <a href=\"/scholarship-application-form/\">\r\n    <img \r\n      src=\"/media/hanf3zu4/qe-dubai-sports-city_ditial_scholarship_website-popup-banner.jpg\" \r\n      alt=\"Popup\" \r\n      class=\"popup-img desktop-img\"\r\n    />\r\n     </a>\r\n    <!-- Mobile image -->\r\n     <a href=\"/scholarship-application-form/\">\r\n    <img \r\n      src=\"/media/t1hh2jrz/qe-dubai-sports-city_ditial_scholarship_mobile-popup-banner.jpg\" \r\n      alt=\"Popup Mobile\" \r\n      class=\"popup-img mobile-img\"\r\n    />\r\n     </a>\r\n  </div>\r\n</div>\r\n\r\n  <style>\r\n  .popup-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: rgba(0,0,0,0.6);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 999;\r\n  visibility: hidden;\r\n  opacity: 0;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n/* Show the popup */\r\n.popup-overlay.active {\r\n  visibility: visible;\r\n  opacity: 1;\r\n    z-index: 99999;\r\n}\r\n\r\n/* Popup box */\r\n.popup-content {\r\n  position: relative;\r\n  background: #fff;\r\n  padding: 0px;\r\n  border-radius: 0px;\r\n  box-shadow: 0 4px 20px rgba(0,0,0,0.3);\r\n  text-align: center;\r\n  animation: fadeIn 0.4s ease;\r\n}\r\n\r\n/* Close button */\r\n.close-btn {\r\n position: absolute;\r\n  top: 12px;\r\n  right: 14px;\r\n  font-size: 44px;\r\n  width: 45px;\r\n  height: 45px;\r\n  background: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  color: #00143e;\r\n  transition: color 0.2s ease;\r\n  background: #b99863;\r\n  z-index: 9;\r\n}\r\n\r\n\r\n@keyframes fadeIn {\r\n  from { transform: scale(0.9); opacity: 0; }\r\n  to { transform: scale(1); opacity: 1; }\r\n}\r\n.popup-img {\r\n  width: 100%;\r\n  height: auto;\r\n  border-radius: 0px;\r\n}\r\n\r\n/* Hide mobile version by default */\r\n.mobile-img {\r\n  display: none;\r\n}\r\n\r\n/* Show mobile image, hide desktop image on small screens */\r\n@media (max-width: 768px) {\r\n  .desktop-img {\r\n    display: none;\r\n  }\r\n  .mobile-img {\r\n    display: block;\r\n  }\r\n}\r\n\r\n  </style>\r\n<script>\r\nwindow.addEventListener(\"load\", () => {\r\n  const popup = document.getElementById(\"popup\");\r\n  const closeBtn = document.getElementById(\"closePopup\");\r\n\r\n  // --- Cookie Helpers ---\r\n  function setCookie(name, value) {\r\n    document.cookie = `${name}=${value}; path=/; SameSite=Lax`;\r\n  }\r\n\r\n  function getCookie(name) {\r\n    const cname = name + \"=\";\r\n    const decoded = decodeURIComponent(document.cookie);\r\n    const ca = decoded.split(';');\r\n    for (let i = 0; i < ca.length; i++) {\r\n      let c = ca[i].trim();\r\n      if (c.indexOf(cname) === 0) {\r\n        return c.substring(cname.length, c.length);\r\n      }\r\n    }\r\n    return \"\";\r\n  }\r\n\r\n  // --- Check if Popup Should Show ---\r\n  const popupClosed = getCookie(\"popupClosed\");\r\n\r\n  if (!popupClosed) {\r\n    popup.classList.add(\"active\");\r\n  }\r\n\r\n  // --- Close Popup & Remember ---\r\n  closeBtn.addEventListener(\"click\", () => {\r\n    popup.classList.remove(\"active\");\r\n    // Set cookie permanently (no expiry)\r\n    setCookie(\"popupClosed\", \"true\");\r\n    // Double safety: also store in localStorage\r\n    localStorage.setItem(\"popupClosed\", \"true\");\r\n  });\r\n\r\n  // Also check localStorage (backup)\r\n  if (localStorage.getItem(\"popupClosed\") === \"true\") {\r\n    popup.classList.remove(\"active\");\r\n  }\r\n});\r\n</script>",
      "codeBehaviour": "",
      "contentTypeKey": "22cbdd86-0e77-4b68-a4a1-29d651547067",
