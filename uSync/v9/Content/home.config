    <pageBeforeClosingBodyScripts>
      <Value Culture="en-us"><![CDATA[
    <script>
document.addEventListener("DOMContentLoaded", function () {
    const items = document.querySelectorAll('.component-main .item');

    const flipInView = () => {
        items.forEach(item => {
            const rect = item.getBoundingClientRect();
            const inView = rect.top < window.innerHeight && rect.bottom > 0;

            if (inView) {
                item.classList.add('flip-active');
                item.classList.remove('flip-inactive');
            } else {
                item.classList.add('flip-inactive');
                item.classList.remove('flip-active');
            }
        });
    };

    // Initial check
    flipInView();

    // On scroll
    window.addEventListener('scroll', flipInView);
});


document.addEventListener("DOMContentLoaded", () => {
  const boxes = document.querySelectorAll(".component-main .box");

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add("show");
      } else {
        entry.target.classList.remove("show"); 
        // ❗ remove this line if you want the animation to happen only once
      }
    });
  }, { threshold: 0.2 }); // adjust sensitivity (0.2 = 20% visible)

  boxes.forEach(box => observer.observe(box));
});

</script>



    ]]></Value>
    </pageBeforeClosingBodyScripts>
    <pageHeaderOpeningScripts>
      <Value Culture="en-us"><![CDATA[
<style>

.homebanner .slick-slider ul.slick-dots {
    display: flex !important;
}
@media (max-width: 512px) {
    .homebanner .slick-slider .slick-list, .component .slick-slider .slick-track {
        padding-right: 0px !important;
    }
}

.qe_program .image :after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgb(0 0 0 / 61%);
    pointer-events: none;
}
.ratio-16x9::before{
    --bs-aspect-ratio: 50%;
}
.yearlogo{
    display: inline-block;
    width: 153px;
    height: 153px;
}
.college-banner-slide h2.heading {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    white-space: nowrap;
    gap: 10px ;
}
.custom-card-section{
    background: linear-gradient(0deg, #00142e00 50%, #00142e 50%) !important;
}

.overlay-card .inner:after{
    content: "";
    position:absolute;
    width:100%;
    height:100%;
    top:0;
    left:0;
    background: linear-gradient(180deg, rgba(0, 20, 46, 0) 46.73%, rgba(0, 20, 46, 0.9) 80.47%);
}
.apply-now-section{
    padding: 190px 0px !important;
}
.apply-now-section .background-image{
    width: 500px !important;
    height: 500px !important;
    margin: auto;
    background-size: contain !important;
    // animation: spin 10s linear infinite;
}
.reveal-out .apply-now-section .background-image{
    animation: none;
}
.apply-now-section .component-introduction .info{
background: #fff;
    border-top: 1px solid #85754E;
    border-bottom: 1px solid #85754E;
    padding: 20px;
    width: 300px !important;
    max-width: 600px !important;
    overflow: visible;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
.apply-now-section .component-introduction .info h2{
    white-space: nowrap;
}

    
.mission-vision-value .component-main .info{
   padding-bottom: 60px !important;
}

.custom-btn2{
    position: absolute;
    margin: auto;
    text-align: center;
    width: 100%;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
}

.welcome-image{
    padding-bottom: 0 !important;
    padding-right: 0 !important;
    padding-top: 20px !important;
}
.executive-welcome{
        padding: 0 100px 0px 0px !important;
}

.explore-section .component-main{
    display: grid !important;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
}
.explore-section .component-main .item{
    max-width: 100% !important;
}
.carousel .component-introduction {
    width: 100% !important;
    display: block !important;
}
.carousel .component-introduction .info{
    max-width: 100% !important;
}
.carousel .component-introduction .info .link{
    position: absolute;
    top: 0;
    right: 0;
    margin:0;
}
.carousel .component-introduction .link a{
    margin: 0px !important;
}
.rotate-image{
    width: 400px !important;
    height:400px;
    display:none;
}
.rotate-image.show{
    display: block;
}
.rotate-image .image{
    width: 400px !important;
    height:400px;
    padding: 30px;
    margin: auto;
}
.rotate-image .image img{
    width: 400px !important;
    height:400px;
    // animation: spin  10s linear infinite;
}
.carousel .link a{
    background: none !important;
}
.carousel .info .text{
    margin-bottom: 20px !important;
}
.mission-vision-value .component-introduction{
    padding: 25px !important;
}
html body.content-underline-link #site-content .item.overlay-card .inner a:not(.btn):not(.nav-button-link):not(:hover):not(:focus):not(:active) .info p.heading{
    text-decoration: none !important;
}
html body.content-underline-link #site-content .item.hover-effect .inner a:not(.btn):not(.nav-button-link):not(:hover):not(:focus):not(:active) .info p.heading{
    text-decoration: none !important;
}
.custom-video{
    width: 80% !important;
    margin: auto !important;
    position: relative;
}
.mute-icon{
    width: 100px;
    height: 100px;
    border-radius: 50vw;
    background:#00142e;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    justify-content: center;
    align-items: center;
    
}
.mute-icon img{
    width: 50px;
    height: 50px;
}


    .principal-video-section-desktop{
        display: flex;
        justify-content: center;
    }

    .principal-video-section-desktop .lazyframe{
        background-image: url("/media/hfmhoihu/principal-image.webp") !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
        width: 50%;
    }
    
        .principal-video-section-mobile .lazyframe{
        background-image: url("/media/hfmhoihu/principal-image.webp") !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    .principal-video-section-desktop .lazyframe[data-vendor="vimeo"]:after{
        width:70px;
        height:70px;
        border-radius:35px;
        background-image:url("/media/taens5hz/play-icon.svg");
        background-color:unset;
    }
        .principal-video-section-mobile .lazyframe[data-vendor="vimeo"]:after{
        width:50px;
        height:50px;
        border-radius:35px;
        background-image:url("/media/taens5hz/play-icon.svg");
        background-color:unset;
    }

    .principal-video-section-desktop .lazyframe[data-vendor="vimeo"]:hover:after {
         background-color:unset;
         background-image:url("/media/taens5hz/play-icon.svg");
    }
    
        .principal-video-section-mobile .lazyframe[data-vendor="vimeo"]:hover:after {
         background-color:unset;
         background-image:url("/media/taens5hz/play-icon.svg");
    }


