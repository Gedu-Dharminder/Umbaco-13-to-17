@inherits UmbracoViewPage<SiteBuilderBaseViewModel>
@using USNSiteBuilder.Core.Models
@using System.Globalization
@using Umbraco.Cms.Core.Routing
@inject IPublishedUrlProvider PublishedUrlProvider

@{
    Layout = "USNMaster.cshtml";

    Usnstyle websiteStyle = (Usnstyle)Model.WebsiteStyle;

    int blogLandingPageID = Model.IsDocumentType(UsnblogLandingPage.ModelTypeAlias)
        ? Model.Id
        : Model.AncestorOrSelf(UsnblogLandingPage.ModelTypeAlias).Id;

    var blogs = Umbraco.Content(blogLandingPageID);

    var categories = blogs?
        .Children()
        .FirstOrDefault(x => x.Name == "Categories")?
        .Children()
        .Where(x => x.IsPublished())
        .OrderByDescending(x => x.CreateDate)
        ?? Enumerable.Empty<IPublishedContent>();

    var posts = blogs?
        .Children()
        .FirstOrDefault(x => x.Name == "Posts")?
        .Children()
        .Where(x => x.IsPublished())
        .OrderByDescending(x => x.Value<DateTime?>("postDate"))
        ?? Enumerable.Empty<IPublishedContent>();

    var mostRecentBlog = posts
        .OrderByDescending(x => x.Value<DateTime?>("postDate"))
        .FirstOrDefault();
    
    var remainingPosts =  posts
        .OrderByDescending(x => x.Value<DateTime?>("postDate"));
    
    var allCount = remainingPosts.Count();
}

@section BodyTag
{
    @await Html.PartialAsync(Model.ThemeFolder + "/MiscPageElements/BodyTag",
        Model,
        new ViewDataDictionary(ViewData)
        {
            { "pageLayout", Model.PageLayoutSettings.PageLayout }
        })
}

<!-- 🔥 HERO / BANNER -->
@if (mostRecentBlog != null)
{
    var title = mostRecentBlog.Value<string>("pageListingHeading") ?? mostRecentBlog.Name;
    var readTime = mostRecentBlog.Value<string>("readingTime");
    var image = mostRecentBlog.Value<IPublishedContent>("pageListingImage");
    var imageUrl = image?.Url() ?? "/images/placeholder.jpg";
var url = mostRecentBlog.Url();
    var dateValue = mostRecentBlog.Value<DateTime?>("postDate");
    var formattedMonth = dateValue?.ToString("MMMM", CultureInfo.InvariantCulture);
    var formattedYear = dateValue?.ToString("dd, yyyy", CultureInfo.InvariantCulture);

    var authors = mostRecentBlog.Value<IEnumerable<IPublishedContent>>("postAuthor");

    <div class="bannerpost">
        <div class="left-side">
            
            <div class="content">
                <span class="recent-badge">Recent blog</span>
                <h1>@Html.Raw(title)</h1>

                <ul> @if (authors != null && authors.Any())
                        {
                    <li><span class="svgicon"><img src="/media/dyshmiha/author.svg" /></span>
                       
                            @string.Join(", ", authors.Select(x => x.Name))
                       
                    </li>
                     }
                    <li><span class="svgicon"><img src="/media/dg5fmgdn/calander-2.svg" /></span> @formattedMonth @formattedYear</li>

                    @if (!string.IsNullOrEmpty(readTime))
                    {
                        <li><span class="svgicon"><img src="/media/epzpx403/clockicon.svg" /></span> @readTime</li>
                    }
                </ul>
                <a href="@url" class="read-more">
                      Read More →
                    </a>
            </div>
        </div>

        <div class="right-side">
            <img src="@imageUrl" />
        </div>
    </div>
}

<div class="container">

    <!-- 🔘 FILTERS -->
    @if (categories.Any())
    {
        <div class="filter-section">
            <div class="filter-box">
                <div class="filter-buttons">

                <button class="resource-filter active" data-filter="all">
                    All Blogs <span class="filter-count">@allCount</span>
                </button>

                @foreach (var cat in categories)
                {
           
                var count = remainingPosts.Count(post =>
                {
                    var postCategories = post.Value<IEnumerable<IPublishedContent>>("postCategories");
                    return postCategories != null && postCategories.Any(c => c.Id == cat.Id);
                });

                    <button class="resource-filter" data-filter="@cat.Name">
                        @cat.Name <span class="filter-count">@count</span>
                    </button>
                }
                
            </div>
            <lable class="searchInputlable">
                <input type="text" placeholder="Search blog..." class="searchInput">
            </lable>
            </div>
        </div>
    }

    <!-- 📰 POSTS -->
    @if (remainingPosts.Any())
    {
        <div id="newsContainer">
            @foreach (var item in remainingPosts)
            {
                var title = item.Value<string>("pageListingHeading") ?? item.Name;
                var image = item.Value<IPublishedContent>("pageListingImage");
                var imageUrl = image?.Url() ?? "/images/placeholder.jpg";
                var dateValue = item.Value<DateTime?>("postDate");
                var formattedMonth = dateValue?.ToString("MMMM", CultureInfo.InvariantCulture);
                var formattedYear = dateValue?.ToString("dd, yyyy", CultureInfo.InvariantCulture);
                var readTime = item.Value<string>("readingTime");
                var authors = item.Value<IEnumerable<IPublishedContent>>("postAuthor");
                var url = item.Url();
                var description = item.Value<string>("pageSummary");
                var categoriesList = item.Value<IEnumerable<IPublishedContent>>("postCategories");

                var categoryNames = categoriesList != null
                    ? string.Join(",", categoriesList.Select(x => x.Name.ToLower()))
                    : "";

                <div class="news-item" data-category="@categoryNames">
                    <div class="card">
                  <div class="card-image">
                    <img src="@imageUrl" alt="STEM Education" />
                    <span class="badge">@categoryNames</span>
                  </div>
                
                  <div class="card-content">
                    <h2>@Html.Raw(title)</h2>
                    <div class="descripiton">
                      @Html.Raw(description)
                    </div>
                
                    <div class="divider"></div>
                
                    <div class="meta">
                         @if (authors != null && authors.Any())
                                        {
                                         <div class="author"><span class="svgicon"><img src="/media/sa3e2pwd/goldenauthoricon.svg" /></span> @string.Join(", ", authors.Select(x => x.Name))</div>
                                        }
                      <div class="date"><span class="svgicon"><img src="/media/r0acsjoz/grey-calander-icon.svg" /></span> @formattedMonth @formattedYear</div>
                      <div class="read-time"><span class="svgicon"><img src="/media/gzbijnv4/grey-clock-icon.svg" /> </span> @readTime</div>
                    </div>
                
                    <a href="@url" class="read-more">
                      Read More →
                    </a>
                  </div>
                </div>
                                </div>
                            }
                        </div>
    }
</div>

