<!-- ⚙️ SCRIPT -->
<script>
document.addEventListener("DOMContentLoaded", function () {

    const buttons = document.querySelectorAll(".resource-filter");
    const items = document.querySelectorAll(".news-item");
    const searchInput = document.querySelector(".searchInput");

    let activeFilter = "all";
    let searchText = "";

    function applyFilter() {
        const filter = activeFilter.toLowerCase();
        const search = searchText.toLowerCase();

        buttons.forEach(b => {
            b.classList.toggle("active", b.dataset.filter.toLowerCase() === filter);
        });

        items.forEach(item => {
            const categories = (item.dataset.category || "").toLowerCase();
            const title = item.querySelector("h2")?.textContent.toLowerCase() || "";
            const description = item.querySelector(".descripiton p")?.textContent.toLowerCase() || "";
            const text = title + " " + description;

            const matchCategory = filter === "all" || categories.includes(filter);
            const matchSearch = text.includes(search);

            item.style.display = (matchCategory && matchSearch) ? "block" : "none";
        });
    }

    // Button filter
    buttons.forEach(btn => {
        btn.addEventListener("click", function () {
            activeFilter = this.dataset.filter;

            const url = new URL(window.location);
            url.searchParams.set("type", activeFilter.toLowerCase());
            window.history.replaceState({}, "", url);

            applyFilter();
        });
    });

    // Search input
    searchInput.addEventListener("input", function () {
        searchText = this.value;
        applyFilter();
    });

    // Load from URL
    const params = new URLSearchParams(window.location.search);
    activeFilter = params.get("type") || "all";

    applyFilter();
});


const filterContainer = document.querySelector('.filter-buttons');
const filters = document.querySelectorAll('.resource-filter');

filters.forEach(btn => {
    btn.addEventListener('click', (e) => {

        // If clicking active → just toggle dropdown
        if (btn.classList.contains('active')) {
            filterContainer.classList.toggle('dropdown-active');
            return;
        }

        // Remove old active
        filters.forEach(b => b.classList.remove('active'));

        // Set new active
        btn.classList.add('active');

        // Close dropdown
        filterContainer.classList.remove('dropdown-active');
    });
});
</script>