@inherits UmbracoViewPage<IPublishedContent>
@using USNSiteBuilder.Core.Models
@using USNSiteBuilder.Core.Extensions
@using Microsoft.Extensions.Options
@using USNSiteBuilder.Core.Interfaces
@inject IOptions<USNAppSettings> _appSettings
@inject ISiteBuilderService _siteBuilderService
@{
    ImageSettings imageSettings = (ImageSettings)ViewData["imageSettings"];
    string themeFolder = ViewData["themeFolder"].ToString();

    if (Model != null && Model.Url().IsNotNullOrEmpty())
    {
        string currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
        int imageWidth = imageSettings.Width;
        int imageHeight = imageSettings.Height;
        int byteLimit = _appSettings.Value.FrontEndImageSizeLimitBytes;

        if (Model.Value<string>("umbracoExtension") != "svg" && Model.Value<int>("umbracoBytes") <= byteLimit)
        {
            string smallImage = String.Empty;
            string displayImageX1 = String.Empty;
            string displayImageX2 = String.Empty;
            bool webPEnabled = _appSettings.Value.WebPEnabled && !Model.Value<bool>("disableWebPConversion");
            int imageQuality = Model.HasValue("imageQuality") ? Model.Value<int>("imageQuality") : 75;

            if (imageSettings.CropAlias == "NO CROP")
            {
                imageWidth = Model.Value<int>("umbracoWidth");
                imageHeight = Model.Value<int>("umbracoHeight");
                smallImage = Model.Url() + "?width=" + (imageWidth / 10) + "&height=" + (imageHeight / 10) + "&quality=" + imageQuality;
                displayImageX1 = Model.Url() + "?width=" + (imageWidth / 2) + "&height=" + (imageHeight / 2) + "&quality=" + imageQuality;
                displayImageX2 = Model.Url() + "?width=" + imageWidth + "&height=" + imageHeight + "&quality=" + imageQuality;
            }
            else if (imageSettings.BoxPad)
            {
                smallImage = Model.Url() + "?width=" + (imageWidth / 10) + "&height=" + (imageHeight / 10) + "&rmode=boxpad&quality=" + imageQuality;
                displayImageX1 = Model.Url() + "?width=" + (imageWidth / 2) + "&height=" + (imageHeight / 2) + "&rmode=boxpad&quality=" + imageQuality;
                displayImageX2 = Model.Url() + "?width=" + imageWidth + "&height=" + imageHeight + "&rmode=boxpad&quality=" + imageQuality;
            }
            else
            {
                smallImage = Model.GetCropUrl(cropAlias: imageSettings.CropAlias, width: (imageWidth / 10), height: (imageHeight / 10)) + "&quality=" + imageQuality;
                displayImageX1 = Model.GetCropUrl(cropAlias: imageSettings.CropAlias, width: (imageWidth / 2), height: (imageHeight / 2)) + "&quality=" + imageQuality;
                displayImageX2 = Model.GetCropUrl(cropAlias: imageSettings.CropAlias, width: imageWidth, height: imageHeight) + "&quality=" + imageQuality;
            }

            @if (webPEnabled)
            {
            <picture>
                <source type="image/webp" data-srcset="@(displayImageX1)&format=webp 1x, @(displayImageX2)&format=webp 2x" width="@(imageWidth / 2)" height="@(imageHeight / 2)">
                <img class="lazyload @imageSettings.CircleClass" src="@smallImage&format=webp" data-src="@(displayImageX1)&format=webp" width="@(imageWidth / 2)" height="@(imageHeight / 2)" alt="@(_siteBuilderService.GetAlternativeText(Model.HasValue("alternativeText") ? Model.Value<string>("alternativeText") : String.Empty,currentCulture))">
            </picture>
            }
            else 
            {
            <picture>
                <source data-srcset="@(displayImageX1)&quality=100 1x, @(displayImageX2)&quality=100 2x" width="@(imageWidth / 2)" height="@(imageHeight / 2)">
                <img class="lazyload @imageSettings.CircleClass" src="@smallImage" data-src="@displayImageX1" width="@(imageWidth / 2)" height="@(imageHeight / 2)" alt="@(_siteBuilderService.GetAlternativeText(Model.HasValue("alternativeText") ? Model.Value<string>("alternativeText") : String.Empty,currentCulture))">
            </picture>
            }
        }
        else if (Model.Value<string>("umbracoExtension") != "svg" && Model.Value<int>("umbracoBytes") > byteLimit)
        {
            if (imageSettings.CropAlias == "NO CROP")
            {
                imageWidth = Model.Value<int>("umbracoWidth");
                imageHeight = Model.Value<int>("umbracoHeight");
            }

            <div class="image-error" data-error-title="@Umbraco.GetDictionaryValue("USN Image Size Error")">
                <img class="@imageSettings.CircleClass image-error" src="/images/@themeFolder/grey.gif" width="@(imageWidth)" height="@(imageHeight)" alt="@(_siteBuilderService.GetAlternativeText(Model.HasValue("alternativeText") ? Model.Value<string>("alternativeText") : String.Empty,currentCulture))">
            </div>
        }
        else
        {
            <img src="@Model.Url()" alt="@(Model.Value<string>("alternativeText"))">
        }
    }
}