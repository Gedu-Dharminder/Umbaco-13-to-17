@inherits UmbracoViewPage<SiteBuilderBaseViewModel>
@using USNSiteBuilder.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@using System.Globalization
@using Umbraco.Cms.Core.Routing
@inject IPublishedUrlProvider PublishedUrlProvider
@{
    Layout = "USNMaster.cshtml";
    Usnstyle websiteStyle = (Usnstyle)Model.WebsiteStyle;
    int blogLandingPageID = Model.IsDocumentType(UsnblogLandingPage.ModelTypeAlias) ? Model.Id : Model.AncestorOrSelf(UsnblogLandingPage.ModelTypeAlias).Id;
    var blog = Model;
    var articleUrl = blog.Url(mode: UrlMode.Absolute);
    var readTime = blog.Value<string>("readingTime");
    var categoriesList = blog.Value<IEnumerable<IPublishedContent>>("postCategories");
    var authors = blog.Value<IEnumerable<IPublishedContent>>("postAuthor");
    var Tags = blog.Value<IEnumerable<string>>("tags");
    var dateValue = blog.Value<DateTime?>("postDate");
    var formattedMonth = dateValue?.ToString("MMMM", CultureInfo.InvariantCulture);
    var formattedYear = dateValue?.ToString("dd, yyyy", CultureInfo.InvariantCulture);
var faqs = Model.Value<BlockListModel>("fAQs", fallback: Fallback.To(Fallback.Ancestors, Fallback.DefaultValue, Fallback.Language));
    var blogpage = Model.AncestorOrSelf(UsnblogLandingPage.ModelTypeAlias);
    var categories = blogpage?
    .Children()
    .FirstOrDefault(x => x.Name == "Categories")?
    .Children()
    .Where(x => x.IsPublished())
    .OrderByDescending(x => x.CreateDate)
    ?? Enumerable.Empty<IPublishedContent>();
    
    var allPosts = blog.Parent.Children()
                    .Where(x => x.IsVisible());

    // Filter related posts
    var relatedPosts = allPosts
        .Where(post => post.Id != blog.Id &&
            post.Value<IEnumerable<IPublishedContent>>("postCategories")
                .Any(cat => categoriesList.Select(c => c.Id).Contains(cat.Id))
        )
        .Take(3);
        
    var orderedPosts = blog.Parent.Children()
        .Where(x => x.IsVisible())
        .OrderByDescending(x => x.Value<DateTime?>("postDate"))
        .ToList();

    var otherpost = orderedPosts
        .SkipWhile(x => x.Id != blog.Id) // move until current post
        .Skip(1) // skip current post itself
        .Take(3);
}
    @section BodyTag
{

    @await Html.PartialAsync(Model.ThemeFolder + "/MiscPageElements/BodyTag", Model, new ViewDataDictionary(ViewData) { { "pageLayout", Model.PageLayoutSettings.PageLayout } })
}

    @await Html.PartialAsync(Model.ThemeFolder + "/BlockContainers/BlockComponents", Model, new ViewDataDictionary(ViewData) { { "blockFieldAlias", "aboveMainContent" }, { "pageLayout", "pageLayoutFull" } })

@if (Model.PageLayoutSettings.PageLayout == "pageLayoutFull")
{
 <section class="content base-bg">
        <div class="container">
            <div class="row justify-content-between blog-main">
                 <!--// Content column -->  
                <div class="content-col left-col col-lg-8 col-12 blog-heading pe-md-5">
                    <div class="breadcrum">
                        <ul>
                            <li><a href="@blogpage.Parent.Url()">@blogpage.Parent.Name</a></li>
                            <li><a href="@blogpage.Url()">@blogpage.Name</a></li>
                            <li><a href="@blog.Url()">@blog.Name</a></li>
                        </ul>
                    </div>
                    @if (categoriesList != null && categoriesList.Any())
                    {
                        <ul class="blog-categories">
                        @foreach (var category in categoriesList)
                        {
                            <li>@category.Name</li>
                        }
                        </ul>
                    }
                    @await Html.PartialAsync(Model.ThemeFolder + "/MiscPageElements/PageTitle", Model)
                    <div class="meta-box">
                        @if (authors != null && authors.Any())
                        {
                            <div class="author"><span class="svgicon"><img src="/media/sa3e2pwd/goldenauthoricon.svg" /></span> @string.Join(", ", authors.Select(x => x.Name))</div>
                        }
                        <div class="date"><span class="svgicon"><img src="/media/kc5h2ujj/golden-calander-icon.svg" /></span> @formattedMonth @formattedYear</div>
                        @if(!string.IsNullOrWhiteSpace(readTime)){
                        <div class="read-time"><span class="svgicon"><img src="/media/0jca5owr/gloden-clock-icon.svg" /></span> @readTime</div>
                        }
                    </div>
                    <div class="share-artical-box">
                        <div class="heading-box">
                            <h3>Share this article</h3>
                            <p>Help others discover this content</p>
                        </div>
                        <div class="social-media-box">
                            <ul>
                                <li class="social-icon">
                                    <a href="https://www.facebook.com/sharer/sharer.php?u=@articleUrl" target="_blank">
                                        <img src="/media/inmnp0dm/facebook-2.svg"/>
                                    </a>
                                </li>
                                <li class="social-icon">
                                    <a href="https://www.instagram.com/direct/new/?text=@articleUrl" target="_blank">
                                        <img src="/media/ycnbkmxw/instagram-2.svg"/>
                                    </a>
                                </li>
                                <li class="social-icon">
                                    <a href="https://www.linkedin.com/sharing/share-offsite/?url=@articleUrl" target="_blank">
                                        <img src="/media/35yddcxc/linkedin-2.svg"/>
                                    </a>
                                </li>
                                <li class="social-icon">
                                    <a href="javascript:void(0);" onclick="copyLink('@articleUrl')">
                                        <img src="/media/fhkgetix/copylink.svg" />
                                        <span class="linkcopedtext">Link copied!</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="content-box">
                        @await Html.PartialAsync(Model.ThemeFolder + "/BlockContainers/BlockComponents", Model, new ViewDataDictionary(ViewData) { { "blockFieldAlias", "mainContent" }, { "pageLayout", Model.PageLayoutSettings.PageLayout } })
                    </div>
                    @if (Tags != null && Tags.Any())
                    {
                    <div class="tag-box">
                        <h3 class="heading">Tags</h3>
                        <div class="tags">
                            @foreach (var tag in Tags)
                            {
                                <span class="tag">@tag</span>
                            }
                        </div>
                    </div>
                    }
                </div>
                <!--side column -->
                <div class="content-col col-lg-4 col-12 blog-sidebar">
                    <div class="table-of-content">
                        <h3>Table of Contents</h3>
                        <div id="content-list"></div>
                    </div>
                    @if(categories.Any())
                    {
                        <div class="categories-column">
                        <h3>Categories</h3>
                        @foreach (var cat in categories)
                        {
                            <span class="resource-categories">
                                @cat.Name
                            </span>
                        }
                        </div>
                    }
                <div class="relatedpostbox">
                    <h3>Related Articles</h3>
                    @if(relatedPosts.Any())
                    {
                        foreach (var relpost in relatedPosts)
                        {
                            var relcategories = relpost.Value<IEnumerable<IPublishedContent>>("postCategories");
                            var reldateValue = relpost.Value<DateTime?>("postDate");
                            var relformattedMonth = reldateValue?.ToString("MMMM", CultureInfo.InvariantCulture);
                            var relformattedYear = reldateValue?.ToString("dd, yyyy", CultureInfo.InvariantCulture);
                            var image = relpost.Value<IPublishedContent>("pageListingImage");
                            var imageUrl = image?.Url() ?? "/images/placeholder.jpg";
                            <a href="@relpost.Url()">
                                <div class="post">
                                <div class="image"><img src="@imageUrl"></div>
                                
                                <div class="content">
                                    <ul>
                                    @foreach (var cat in relcategories)
                                    {
                                        <li>@cat.Name</li>
                                    }
                                    </ul>
                                    <h4>@relpost.Name</h4>
                                    <p><span class="svgicon"><img src="/media/r0acsjoz/grey-calander-icon.svg" /></span> @relformattedMonth @relformattedYear</p>
                                </div>
                            </div>
                            </a>
                        }
                        
                    }
                    <a class="viewall" href="@blogpage.Url()">View All Articles</a>
                </div>
            </div>
            </div>
        </div>
    </section>
    @if (faqs != null && faqs.Any())
    
    {
        <section class="faqs-section">
            <div class="container">
                <h3 class="heading">FAQs</h3>
                <div class="faqs">
                    @foreach (var item in faqs)
                    {
                        var content = item.Content;
                        
                        var heading = content.Value<string>("itemHeading");
                        var text = content.Value<string>("repeaterText");
                        
                        <div class="faq-item">
                            <h4 class="faq-heading">@heading</h4>
                            <div class="faq-content">@Html.Raw(text)</div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    @if(otherpost.Any())
    {
        <section class="OtherBlogSection">
            <div class="container">
                <div class="other-blogs">
                    <div class="heading-box">
                        <h2 class="heading">You May Also Explore Our Other Blog Posts</h2>
                        <p>Discover more insights and stories from Queen Elizabeth's School</p>
                    </div>
                    <div class="more-blogs">
                    @foreach (var item in otherpost)
                    {
                        var itemTitle = item.Value<string>("pageListingHeading") ?? item.Name;
                        var itemImage = item.Value<IPublishedContent>("pageListingImage");
                        var itemImageUrl = itemImage?.Url() ?? "/images/placeholder.jpg";
                        var itemDateValue = item.Value<DateTime?>("postDate");
                        var itemFormattedMonth = itemDateValue?.ToString("MMMM", CultureInfo.InvariantCulture);
                        var itemFormattedYear = itemDateValue?.ToString("dd, yyyy", CultureInfo.InvariantCulture);
                        var itemReadTime = item.Value<string>("readingTime");
                        var itemAuthors = item.Value<IEnumerable<IPublishedContent>>("postAuthor");
                        var itemUrl = item.Url();
                        var itemDescription = item.Value<string>("pageSummary");
                        var itemCategoriesList = item.Value<IEnumerable<IPublishedContent>>("postCategories");
                        
                        var categoryNames = itemCategoriesList != null
                        ? string.Join(",", itemCategoriesList.Select(x => x.Name.ToLower()))
                        : "";
                        
                        
                        <div class="news-item" data-category="@categoryNames">
                            <div class="card">
                                <div class="card-image">
                                    <img src="@itemImageUrl" alt="STEM Education" />
                                    <span class="badge">@categoryNames</span>
                                </div>
                                
                                <div class="card-content">
                                    <h3>@Html.Raw(itemTitle)</h3>
                                    <div class="descripiton">
                                        @Html.Raw(itemDescription)
                                    </div>
                                    
                                    <div class="divider"></div>
                                    
                                    <div class="meta">
                                        @if (itemAuthors != null && itemAuthors.Any())
                                        {
                                            <div class="author"><span class="svgicon"><img src="/media/sa3e2pwd/goldenauthoricon.svg" /></span>   @string.Join(", ", itemAuthors.Select(x => x.Name))</div>
                                        }
                                        <div class="date"><span class="svgicon"><img src="/media/r0acsjoz/grey-calander-icon.svg" /></span> @itemFormattedMonth @itemFormattedYear</div>
                                         @if(!string.IsNullOrWhiteSpace(readTime)){
                                        <div class="read-time"><span class="svgicon"><img src="/media/gzbijnv4/grey-clock-icon.svg" /></span> @itemReadTime</div>
                                        }
                                    </div>
                                    
                                    <a href="@itemUrl" class="read-more">
                                    Read More →
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    </div>
                    <a class="viewallbtn" href="@blogpage.Url()">View All Articles →</a>
                </div>
            </div>
        </section>
    }
    
}

