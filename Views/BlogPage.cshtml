<style>


/*icone syling */

.svgicon{
    display: inline-block;
    width: 16px;
    height: 16px;
}
.svgicon img{
    width: 100%;
    height: 100%;
    margin-bottom: 5px;
}
/*********************************************breadcrum styling******************************************/


.breadcrum ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap; 
    font-family: Soleil;
    margin-bottom: 20px;
}


.breadcrum li {
    display: flex;
    align-items: center;
}


.breadcrum li a {
    text-decoration: none !important;
    color: #6A7282 !important; 
    font-size: 16px;
    transition: color 0.2s ease;
}

.breadcrum li:last-child a {
    color: #364153 !important; 
    pointer-events: none;
    font-weight: 400;
}


.breadcrum li:not(:last-child) a:hover {
    color: #1e293b;
    text-decoration: underline !important;
}

.breadcrum li:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid #6A7282 !important;
    border-bottom: 1.5px solid #6A7282 !important;
    transform: rotate(-45deg); 
    margin: 0 15px;
    flex-shrink: 0;
}



/******************************************layout styling***************************************/

.blog-sidebar{
    position: sticky;
    top: 185px;
    height: fit-content;
}
.blog-main{
    position: relative;
}
.content-box .container{
    padding: 0px !important;
}

h3{
    font-size: 30px !important;
}
table , table th, table td{
    border: none !important;
}
/***************************************Share this artical styling******************************/

.share-artical-box {
    margin-top: 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25px;
  border-top: 1px solid #E5E7EB;
  border-bottom: 1px solid #E5E7EB;
  background: linear-gradient(90deg, #F9FAFB 0%, #FFFFFF 100%);

}


.heading-box h3 {
  margin: 0;
  color: #00142E;
  font-family: Tinos;
  font-weight: 400;
  font-size: 18px !important;

}

.heading-box p {
  margin: 5px 0 0;
  color: #6A7282;
  font-family: Soleil;
  font-weight: 400;
  font-size: 13px;

}


.social-media-box ul {
  display: flex;
  gap: 12px;
  padding: 0;
  margin: 0;
  list-style: none;
  position: relative;
}

.social-icon a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: #f3f3f3;
  transition: all 0.3s ease;
}

.social-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.linkcopedtext{
    position: absolute;
    z-index: 9999;
    display: none;
    width: 100%;
    top: 42px;
    right: 0px;
    text-align: end;
    color: #6A7282;
    font-family: Soleil;
    font-weight: 400;
    font-size: 13px;
}
.linkcopedtext.show{
    display: inline-block;
}


/*************************************Heading style*************************************/

.blog-categories{
    list-style: none;
    display: flex;
    gap: 15px;
    margin: 0px;
}
.blog-categories li{
    padding: 5px 10px;
    color: #fff;
    font-family: Soleil;
    font-weight: 400;
    font-size: 12px;
    text-transform: uppercase;
}
.blog-categories li:nth-child(odd){
    background: #00142E;
}
.blog-categories li:nth-child(even){
    background: #85754E;
}
.heading-col{
    padding-bottom: 0px;
}
h1.heading.main.base-heading {
