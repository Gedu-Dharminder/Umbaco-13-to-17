<script>
    document.addEventListener("DOMContentLoaded", function () {
        const headings = document.querySelectorAll("h2");
        const contentList = document.getElementById("content-list");
        
        headings.forEach((heading, index) => {
            // Create an ID if not present
            if (!heading.id) {
                heading.id = "heading-" + index;
            }
            
            // Create list item
            const link = document.createElement("a");
            link.href = "#" + heading.id;
            link.textContent = heading.textContent;
            
            const listItem = document.createElement("div");
            listItem.classList.add("toc-item");
            listItem.appendChild(link);
            
            contentList.appendChild(listItem);
        });
    });
    
    document.querySelectorAll('.resource-categories').forEach(item => {
        item.addEventListener('click', function () {
            let category = this.innerText.trim();
            
            // convert to URL format: lowercase + spaces → +
            let formattedCategory = category
            .toLowerCase()
            .replace(/\s+/g, '+');
            
            // redirect
            window.location.href = `/blog/?type=${formattedCategory}`;
        });
    });
    document.querySelectorAll('.faq-item').forEach(item => {
    const heading = item.querySelector('.faq-heading');
    
    heading.addEventListener('click', () => {
        const isOpen = item.classList.contains('active');

        // Optional: Close all other open items first (Accordion behavior)
        document.querySelectorAll('.faq-item').forEach(el => {
            el.classList.remove('active');
        });

        // If the clicked item wasn't already open, open it
        if (!isOpen) {
            item.classList.add('active');
        }
    });
});

function copyLink(url) {
    navigator.clipboard.writeText(url).then(function () {
        const el = document.querySelector('.linkcopedtext');
        
        el.classList.add('show');

        setTimeout(() => {
            el.classList.remove('show');
        }, 3000);
    });
}


const categories = document.querySelector('.categories-column');
const shareBox = document.querySelector('.share-artical-box');

if (categories && shareBox) {
    const parent = shareBox.parentNode;
    const originalNext = categories.nextSibling;

    function handleMove() {
        if (window.innerWidth <= 991) {
            if (categories !== shareBox.nextElementSibling) {
                parent.insertBefore(categories, shareBox.nextSibling);
            }
        } else {
            if (categories.nextSibling !== originalNext) {
                parent.insertBefore(categories, originalNext);
            }
        }
    }

    // run once
    handleMove();

    // optimized resize (no constant firing)
    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(handleMove, 150);
    });
}

</script>